{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rafaelia.execution_plan.v1",
  "title": "ExecutionPlan",
  "description": "Ordered list of ToolRequests generated after governance gate approval. Immutable once created.",
  "type": "object",
  "required": ["plan_id", "intent_id", "gate_decision", "steps", "created_at"],
  "additionalProperties": false,
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$"
    },
    "intent_id": {
      "type": "string"
    },
    "gate_decision": {
      "type": "string",
      "enum": ["allow"],
      "description": "Only 'allow' plans are ever executed; others are rejected before reaching this schema"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "rafaelia.tool_request.v1"
      },
      "description": "Ordered sequence of ToolRequests"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "Plan must be executed before this time or discarded"
    },
    "source_bundle_id": {
      "type": ["string", "null"]
    }
  }
}
