{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rafaelia.execution_result.v1",
  "title": "ExecutionResult",
  "description": "Auditable record of a single ToolRequest execution. Immutable after creation.",
  "type": "object",
  "required": [
    "result_id",
    "intent_id",
    "executed_command",
    "args",
    "working_directory",
    "started_at",
    "ended_at",
    "exit_code",
    "stdout_truncated",
    "stderr_truncated",
    "stdout_sha256",
    "stderr_sha256",
    "artifacts",
    "final_state",
    "rollback_available",
    "source_chunk_refs"
  ],
  "additionalProperties": false,
  "properties": {
    "result_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$",
      "description": "Unique append-only execution directory identifier."
    },
    "intent_id": {
      "type": "string"
    },
    "plan_id": {
      "type": ["string", "null"]
    },
    "executed_command": {
      "type": "string",
      "description": "The exact executable that was run"
    },
    "args": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Exact argument list passed (no shell expansion)"
    },
    "working_directory": {
      "type": "string",
      "description": "Absolute path where the command ran"
    },
    "result_directory": {
      "type": "string",
      "description": "Immutable directory that contains this receipt and its command logs."
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "exit_code": {
      "type": "integer",
      "description": "Nonzero when any required command failed."
    },
    "stdout_truncated": {
      "type": "string",
      "maxLength": 4096,
      "description": "First 4096 chars of combined stdout"
    },
    "stderr_truncated": {
      "type": "string",
      "maxLength": 4096,
      "description": "First 4096 chars of combined stderr"
    },
    "stdout_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of complete combined stdout before truncation"
    },
    "stderr_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of complete combined stderr before truncation"
    },
    "artifacts": {
      "type": "array",
      "description": "List of output artifacts produced (paths, hashes)",
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "properties": {
          "name": {"type": "string"},
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "command_results": {
      "type": "array",
      "description": "Per-command evidence preserving exact exit codes and log hashes.",
      "items": {
        "type": "object",
        "required": [
          "name",
          "args",
          "exit_code",
          "stdout_path",
          "stderr_path",
          "stdout_sha256",
          "stderr_sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "exit_code": {"type": "integer"},
          "stdout_path": {"type": "string"},
          "stderr_path": {"type": "string"},
          "stdout_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "stderr_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "final_state": {
      "type": "string",
      "enum": ["success", "failure", "timeout", "blocked"],
      "description": "Terminal state of the execution"
    },
    "evidence_state": {
      "type": "string",
      "enum": ["complete", "partial"],
      "description": "Whether command outcome and provenance are both available."
    },
    "target_commit": {
      "type": "string",
      "description": "HEAD of the repository inspected, or a typed TOKEN_VAZIO."
    },
    "runner_commit": {
      "type": "string",
      "description": "Commit that supplied the runner, or a typed TOKEN_VAZIO."
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "description": "SHA-256 identities of inputs and the runner."
    },
    "receipt_payload_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 of canonical receipt payload before this field is added."
    },
    "claim_allowed": {
      "type": "boolean",
      "const": false,
      "description": "A read-only receipt never promotes a broader claim."
    },
    "rollback_available": {
      "type": "boolean",
      "description": "Whether the operation can be rolled back (always false for read-only)"
    },
    "source_chunk_refs": {
      "type": "array",
      "description": "Chunk IDs that ultimately triggered this execution",
      "items": {"type": "string"}
    }
  }
}
