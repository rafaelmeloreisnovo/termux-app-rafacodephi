{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rafaelia.context_bundle.v1",
  "title": "ContextBundle",
  "description": "Assembled context derived from one or more ConversationChunks. Input to the intent extraction stage.",
  "type": "object",
  "required": ["bundle_id", "chunk_refs", "assembled_at", "working_directory", "active_repos"],
  "additionalProperties": false,
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{8,64}$"
    },
    "chunk_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunk_id", "source_repo"],
        "properties": {
          "chunk_id": { "type": "string" },
          "source_repo": { "type": "string" },
          "content_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "assembled_at": {
      "type": "string",
      "format": "date-time"
    },
    "working_directory": {
      "type": "string",
      "description": "Absolute path of the repo being acted on"
    },
    "active_repos": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of repos in scope for this bundle"
    },
    "summary_hint": {
      "type": ["string", "null"],
      "description": "Optional short summary of the context (not trusted for execution)"
    }
  }
}
