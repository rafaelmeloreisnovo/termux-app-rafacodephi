{
  "schema": "raf.loose-artifact-policy.v2",
  "scan_roots": ["Arme", "BugOrAdd", "rafaelia/old"],
  "scan_root_files": true,
  "root_extensions": [".txt", ".md", ".html", ".json", ".yaml", ".yml", ".c", ".h", ".s", ".S", ".asm", ".sh", ".py"],
  "root_exclusions": [
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "AGENTS.md",
    "Browser.sh"
  ],
  "skip_directories": [".git", ".gradle", "build", ".idea", "node_modules", "__pycache__"],
  "status_default": "REVIEW_REQUIRED",
  "states": [
    "REVIEW_REQUIRED",
    "CANDIDATE_SOURCE",
    "CANDIDATE_DOCUMENT",
    "HISTORICAL",
    "DUPLICATE_CONTENT",
    "QUARANTINE",
    "CANONICAL"
  ],
  "targets": {
    "c_source": "apkc/candidates-or-archive",
    "asm_source": "docs/lowlevel-index-or-native-candidate",
    "script": "scripts/candidates-or-archive",
    "document": "docs/recovered",
    "data": "configs/recovered",
    "unknown": "archive/quarantine"
  },
  "metadata_defaults": {
    "origin": "TOKEN_VAZIO",
    "author": "TOKEN_VAZIO",
    "license": "TOKEN_VAZIO"
  },
  "reference_scan": {
    "enabled": true,
    "max_bytes": 1048576,
    "max_references_per_artifact": 64,
    "accepted_schemes": ["https://", "http://"]
  },
  "promotion_requirements": [
    "origin",
    "author",
    "license",
    "references_reviewed",
    "integration_target_approved",
    "consumer_identified",
    "tests_identified"
  ],
  "invariant": "INDEXING_DOES_NOT_PROMOTE_TO_BUILD_OR_RUNTIME",
  "automatic_move": false,
  "automatic_delete": false,
  "automatic_claim_promotion": false
}
