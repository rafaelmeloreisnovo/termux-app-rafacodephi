{
  "schema": "gdrive-plugin-profile-contract/v2",
  "package_name": "com.termux.rafacodephi",
  "plugin_name": "gdrive-plugin",
  "prefix": "/data/data/com.termux.rafacodephi/files/usr",
  "package_layer": "plugin-source",
  "maturity": "DRAFT_FAIL_CLOSED_CLI",
  "claim_allowed": false,
  "release_allowed": false,
  "required_entries": [
    "bin/bash",
    "bin/curl",
    "bin/jq",
    "bin/md5sum",
    "bin/awk",
    "bin/find",
    "bin/stat",
    "bin/base64",
    "bin/od",
    "bin/tr"
  ],
  "optional_entries": [
    "bin/python3",
    "bin/termux-open-url"
  ],
  "scripts": {
    "auth": "plugins/gdrive-plugin/gdrive-auth.sh",
    "sync": "plugins/gdrive-plugin/gdrive-sync.sh",
    "status_service": "plugins/gdrive-plugin/gdrive-webservice.sh"
  },
  "invariants": {
    "http_2xx_required": true,
    "checksum_confirmation_required": true,
    "remote_identity_is_drive_id": true,
    "initial_mismatch_is_conflict": true,
    "concurrent_change_is_conflict": true,
    "downloads_are_atomic": true,
    "recursive_sync": false,
    "deletion_propagation": false,
    "web_write_api": false
  },
  "promotion_rule": "LOCAL_CONTRACT_PASS AND DEVICE_REAL_ACCOUNT_RECEIPTS AND SECURITY_REVIEW",
  "token_vazio": [
    "device_oauth",
    "real_drive_roundtrip",
    "network_fault_injection",
    "armv7_receipt",
    "arm64_receipt",
    "packaging",
    "signature",
    "release"
  ]
}
