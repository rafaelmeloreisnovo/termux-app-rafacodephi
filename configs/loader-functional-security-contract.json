{
  "schema": "termux.rafacodephi.loader-functional-security-contract.v1",
  "authority": "rafaelmeloreisnovo/termux-app-rafacodephi",
  "claim_allowed": false,
  "release_allowed": false,
  "allowed_states": [
    "STUB_SAFE_BLOCKED",
    "FUNCTIONAL_SECURITY_GATED"
  ],
  "forbidden_states": [
    "FUNCTIONAL_UNGATED",
    "EXPORTED_UNAUTHENTICATED",
    "ARBITRARY_TARGET_EXTRACTION",
    "UNPINNED_NETWORK_SOURCE",
    "CLAIMED_WITHOUT_ARTIFACT_EVIDENCE"
  ],
  "stub_invariants": {
    "android_has_code": false,
    "business_java_sources": false,
    "embedded_bootstrap_payload": false,
    "installer_behavior": false,
    "functional_claim": false
  },
  "functional_invariants": {
    "contract_version_min": 2,
    "signature_permission": "com.termux.rafacodephi.permission.BOOTSTRAP_HANDOFF",
    "cleartext": false,
    "arbitrary_target_directory": false,
    "loader_extraction": false,
    "https_only": true,
    "same_origin_redirects": true,
    "implicit_redirects": false,
    "download_budget_bytes_max": 134217728,
    "loader_sha256": true,
    "host_sha256": true,
    "host_blake3": true,
    "provider_private": true,
    "provider_read_only": true,
    "uri_grant_scoped_to_host": true,
    "host_loader_signer_match": true,
    "zip_budget_host_owned": true,
    "atomic_private_inbox": true,
    "external_pins_default_empty": true,
    "embedded_fallback_only_when_external_absent": true
  },
  "forbidden_source_tokens": [
    "EXTRA_TARGET_DIR",
    "target_dir",
    "ZipInputStream",
    "ZipEntry"
  ],
  "promotion_evidence": [
    "source validator PASS",
    "adversarial tests PASS",
    "host and loader APK build PASS",
    "matching signer certificate receipt",
    "unauthorized caller rejected on Android",
    "read-only URI grant and revocation observed",
    "exact URL, SHA-256 and BLAKE3 pins when external route is enabled",
    "DEVICE_RECEIPT_COMPLETE"
  ],
  "boundary": "A safe stub may pass while functional capability remains blocked. A functional loader may pass only when the full host-loader security boundary is present. Partial functionality fails closed."
}
