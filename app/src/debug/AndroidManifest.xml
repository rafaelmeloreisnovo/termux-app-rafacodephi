<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- SensorManager sources whose Android protection is package-specific. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />

    <application>
        <!--
          Debug-only, explicit-entry probe. android.permission.DUMP restricts
          invocation to adb shell / privileged diagnostics; release APKs do not
          contain this component.
        -->
        <activity
            android:name="com.termux.app.rafaelia.RafaeliaZeroProbeActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:finishOnTaskLaunch="true"
            android:noHistory="true"
            android:permission="android.permission.DUMP"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
