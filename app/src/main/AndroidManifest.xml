<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:installLocation="internalOnly">

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <permission
        android:name="${TERMUX_PACKAGE_NAME}.permission.RUN_COMMAND"
        android:description="@string/permission_run_command_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/permission_run_command_label"
        android:protectionLevel="dangerous" />

    <permission
        android:name="${TERMUX_PACKAGE_NAME}.permission.RAF_SENSOR_ACCESS"
        android:description="@string/permission_raf_sensor_access_description"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/permission_raf_sensor_access_label"
        android:protectionLevel="dangerous" />

    <permission
        android:name="${TERMUX_PACKAGE_NAME}.permission.BOOTSTRAP_HANDOFF"
        android:protectionLevel="signature" />

    <permission
        android:name="${TERMUX_PACKAGE_NAME}.permission.TERMUX_API"
        android:protectionLevel="signature" />

    <uses-permission android:name="${TERMUX_PACKAGE_NAME}.permission.BOOTSTRAP_HANDOFF" />
    <uses-permission android:name="${TERMUX_PACKAGE_NAME}.permission.TERMUX_API" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:name="com.termux.app.TermuxApplication"
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/application_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="false"
        android:theme="@style/Theme.TermuxApp.DayNight.DarkActionBar"
        tools:targetApi="m">

        <activity
            android:name="com.termux.app.benchmark.BenchmarkMenuActivity"
            android:exported="false"
            android:label="RafCodePhi Benchmark"
            android:theme="@style/Theme.TermuxApp.DayNight.DarkActionBar" />

        <activity
            android:name="com.termux.app.BootstrapGateActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name="com.termux.app.TermuxActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|density|screenLayout|keyboard|keyboardHidden|navigation"
            android:label="@string/application_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:theme="@style/Theme.TermuxActivity.DayNight.NoActionBar"
            tools:targetApi="n" />

        <activity-alias
            android:name="${TERMUX_PACKAGE_NAME}.HomeActivity"
            android:exported="true"
            android:targetActivity="com.termux.app.BootstrapGateActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.IOT_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name="com.termux.app.activities.HelpActivity"
            android:exported="false"
            android:label="@string/application_name"
            android:parentActivityName="com.termux.app.TermuxActivity"
            android:resizeableActivity="true"
            tools:targetApi="n" />

        <activity
            android:name="com.termux.app.activities.SettingsActivity"
            android:exported="true"
            android:label="@string/title_activity_termux_settings"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.app.activities.BetaOrchestratorActivity"
            android:exported="false"
            android:label="RAFCODEΦ · Control Center"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.app.activities.Android15WizardActivity"
            android:exported="false"
            android:label="@string/title_activity_android15_wizard"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.app.activities.SystemAuditActivity"
            android:exported="false"
            android:label="@string/title_activity_system_audit"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.app.activities.VectraRuntimeActivity"
            android:exported="false"
            android:label="@string/title_activity_vectra_runtime"
            android:theme="@style/Theme.TermuxApp.DayNight.NoActionBar" />

        <activity
            android:name="com.termux.shared.activities.ReportActivity"
            android:theme="@style/Theme.MarkdownViewActivity.DayNight"
            android:documentLaunchMode="intoExisting" />

        <activity
            android:name="com.termux.app.api.file.FileReceiverActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:resizeableActivity="true"
            android:taskAffinity="${TERMUX_PACKAGE_NAME}.filereceiver"
            tools:targetApi="n" />

        <activity-alias
            android:name="com.termux.app.api.file.FileShareReceiverActivity"
            android:exported="true"
            android:targetActivity="com.termux.app.api.file.FileReceiverActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="message/*" />
                <data android:mimeType="multipart/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name="com.termux.app.api.file.FileViewReceiverActivity"
            android:exported="true"
            android:targetActivity="com.termux.app.api.file.FileReceiverActivity">
            <intent-filter tools:ignore="AppLinkUrlError">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="com.termux.filepicker.TermuxDocumentsProvider"
            android:authorities="${TERMUX_PACKAGE_NAME}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <provider
            android:name="com.termux.app.TermuxOpenReceiver$ContentProvider"
            android:authorities="${TERMUX_PACKAGE_NAME}.files"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="${TERMUX_PACKAGE_NAME}.permission.RUN_COMMAND" />

        <receiver
            android:name="com.termux.app.TermuxOpenReceiver"
            android:exported="false" />

        <receiver
            android:name="com.termux.app.BootstrapHandoffReceiver"
            android:exported="true"
            android:permission="${TERMUX_PACKAGE_NAME}.permission.BOOTSTRAP_HANDOFF">
            <intent-filter>
                <action android:name="${TERMUX_PACKAGE_NAME}.BOOTSTRAP_VERIFIED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.termux.app.event.SystemEventReceiver"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.termux.shared.activities.ReportActivity$ReportActivityBroadcastReceiver"
            android:exported="false" />

        <receiver
            android:name="com.termux.app.integration.VectrasIntegrationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.vectras.vm.ACTION_QUERY_INTEGRATION" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.termux.app.TermuxService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="terminal_session" />
        </service>

        <service
            android:name="com.termux.app.RunCommandService"
            android:exported="true"
            android:foregroundServiceType="dataSync|specialUse"
            android:permission="${TERMUX_PACKAGE_NAME}.permission.RUN_COMMAND">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="command_execution" />
            <intent-filter>
                <action android:name="${TERMUX_PACKAGE_NAME}.RUN_COMMAND" />
            </intent-filter>
        </service>

        <service
            android:name="com.termux.app.api.sensor.RafSensorApiService"
            android:exported="true"
            android:foregroundServiceType="dataSync|specialUse"
            android:permission="${TERMUX_PACKAGE_NAME}.permission.RAF_SENSOR_ACCESS">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="sensor_runtime" />
        </service>

        <service
            android:name="com.termux.app.api.sensor.RafSpectralApiService"
            android:exported="true"
            android:foregroundServiceType="dataSync|specialUse"
            android:permission="${TERMUX_PACKAGE_NAME}.permission.RAF_SENSOR_ACCESS">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="bounded_sensor_spectral_analysis" />
        </service>

        <meta-data
            android:name="android.max_aspect"
            android:value="10.0" />
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />
        <meta-data
            android:name="com.samsung.android.multidisplay.keep_process_alive"
            android:value="true" />
        <meta-data
            android:name="com.sec.android.support.multiwindow"
            android:value="true" />

    </application>

</manifest>
