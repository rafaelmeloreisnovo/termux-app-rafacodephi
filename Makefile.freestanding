# RAFCODEPHI freestanding build matrix
# Controller scope only: bootstrap/extractor/pkg probes/RAF-NINJA.
# Platform payloads (apt/dpkg/proot.real) are validated/exec'd, not relabelled freestanding.

ifeq ($(origin CC), default)
CC := clang
endif
READELF ?= llvm-readelf
NM ?= llvm-nm

BUILD_DIR := build/freestanding
BIN_DIR := bin/freestanding

COMMON_CFLAGS := -ffreestanding -nostdlib -nostdinc -fno-builtin \
	-fno-stack-protector -fno-unwind-tables -fno-asynchronous-unwind-tables \
	-ffunction-sections -fdata-sections -fPIE -O2 -Wall -Wextra -Werror \
	-I./src/bootstrap
COMMON_LDFLAGS := -nostdlib -fuse-ld=lld -Wl,-static,-pie,-e,_start,--gc-sections,--build-id=none \
	-Wl,-z,max-page-size=16384

TARGET_aarch64 := aarch64-linux-android21
TARGET_arm := armv7a-linux-androideabi21

BOOTSTRAP_C := \
	src/bootstrap/bootstrap_orchestrator.c \
	src/bootstrap/proot_freestanding_real.c \
	src/bootstrap/extract_payload_real.c \
	src/bootstrap/dpkg_install_real.c \
	src/bootstrap/package_stack_real.c
BOOTSTRAP_S := src/bootstrap/start_arm.S

A64_OBJS := $(patsubst src/%.c,$(BUILD_DIR)/aarch64/%.o,$(BOOTSTRAP_C)) \
	$(patsubst src/%.S,$(BUILD_DIR)/aarch64/%.o,$(BOOTSTRAP_S))
ARM_OBJS := $(patsubst src/%.c,$(BUILD_DIR)/arm/%.o,$(BOOTSTRAP_C)) \
	$(patsubst src/%.S,$(BUILD_DIR)/arm/%.o,$(BOOTSTRAP_S))

.PHONY: all bootstrap bootstrap-aarch64 bootstrap-arm verify-freestanding verify-elf clean size-report help

all: bootstrap verify-freestanding verify-elf

bootstrap: bootstrap-aarch64 bootstrap-arm

bootstrap-aarch64: $(BIN_DIR)/aarch64/raf-bootstrap-ninja
bootstrap-arm: $(BIN_DIR)/arm/raf-bootstrap-ninja

$(BUILD_DIR)/aarch64/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_aarch64) $(COMMON_CFLAGS) -c $< -o $@

$(BUILD_DIR)/aarch64/%.o: src/%.S
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_aarch64) $(COMMON_CFLAGS) -c $< -o $@

$(BUILD_DIR)/arm/%.o: src/%.c
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_arm) -march=armv7-a -mfloat-abi=softfp $(COMMON_CFLAGS) -c $< -o $@

$(BUILD_DIR)/arm/%.o: src/%.S
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_arm) -march=armv7-a -mfloat-abi=softfp $(COMMON_CFLAGS) -c $< -o $@

$(BIN_DIR)/aarch64/raf-bootstrap-ninja: $(A64_OBJS)
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_aarch64) $(COMMON_LDFLAGS) $^ -o $@

$(BIN_DIR)/arm/raf-bootstrap-ninja: $(ARM_OBJS)
	@mkdir -p $(dir $@)
	$(CC) -target $(TARGET_arm) -march=armv7-a -mfloat-abi=softfp $(COMMON_LDFLAGS) $^ -o $@

verify-freestanding:
	@echo '[CHECK] source freestanding/no hosted headers'
	@! grep -REn '^#include[[:space:]]*<(stdio|stdlib|string|unistd|fcntl|pthread|time|sys/|android/|jni)' \
		$(BOOTSTRAP_C) src/bootstrap/freestanding.h src/bootstrap/syscall_arm.h
	@! grep -REn '(^|[^A-Za-z0-9_])(malloc|calloc|realloc|free|printf|fprintf|pthread_[A-Za-z0-9_]+)[[:space:]]*\(' \
		$(BOOTSTRAP_C)
	@echo 'FREESTANDING_SOURCE_POLICY=PASS'

verify-elf: bootstrap
	@set -eu; \
	for f in $(BIN_DIR)/aarch64/raf-bootstrap-ninja $(BIN_DIR)/arm/raf-bootstrap-ninja; do \
		echo "[ELF] $$f"; \
		$(READELF) -hW "$$f" | grep -Eq 'Machine:[[:space:]]+(AArch64|ARM)'; \
		if $(READELF) -dW "$$f" 2>/dev/null | grep -q '(NEEDED)'; then \
			echo "ERROR: DT_NEEDED present in $$f" >&2; exit 1; \
		fi; \
		undef="$$( $(NM) -u "$$f" 2>/dev/null || true )"; \
		if [ -n "$$undef" ]; then echo "ERROR: undefined symbols in $$f: $$undef" >&2; exit 1; fi; \
	done
	@echo 'FREESTANDING_DUAL_ARM_ELF=PASS'

size-report: bootstrap
	@wc -c $(BIN_DIR)/aarch64/raf-bootstrap-ninja $(BIN_DIR)/arm/raf-bootstrap-ninja

clean:
	rm -rf $(BUILD_DIR) $(BIN_DIR)

help:
	@echo 'RAFCODEPHI freestanding controller matrix'
	@echo '  make -f Makefile.freestanding all'
	@echo '  make -f Makefile.freestanding bootstrap-aarch64'
	@echo '  make -f Makefile.freestanding bootstrap-arm'
	@echo '  make -f Makefile.freestanding verify-freestanding'
	@echo '  make -f Makefile.freestanding verify-elf'
